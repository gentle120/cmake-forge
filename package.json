{
  "name": "cmake-embedded",
  "displayName": "CMake Embedded",
  "description": "Generate ready-to-build CMake projects for desktop C/C++, MCU firmware, and Linux / SoC cross compilation.",
  "version": "1.0.0",
  "publisher": "gentle120",
  "repository": {
    "type": "git",
    "url": "https://github.com/gentle120/CMake Embedded.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.0.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "cmake",
    "embedded",
    "mcu",
    "stm32",
    "gd32",
    "linux",
    "cross-compile"
  ],
  "extensionDependencies": [
    "ms-vscode.cmake-tools",
    "ms-vscode.cpptools"
  ],
  "main": "./out/extension.js",
  "icon": "images/icon.png",
  "readme": "README.md",
  "activationEvents": [
    "onView:cmakeEmbedded.sidebar"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cmakeEmbedded",
          "title": "CMake Embedded",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "views": {
      "cmakeEmbedded": [
        {
          "type": "webview",
          "id": "cmakeEmbedded.sidebar",
          "name": "生成配置"
        }
      ]
    },
    "commands": [
      {
        "command": "cmakeEmbedded.generateMcu",
        "title": "CMake Embedded: Generate MCU Project"
      },
      {
        "command": "cmakeEmbedded.generateLinux",
        "title": "CMake Embedded: Generate Linux Project"
      },
      {
        "command": "cmakeEmbedded.generateNative",
        "title": "CMake Embedded: Generate C/C++ Project"
      },
      {
        "command": "cmakeEmbedded.generateFlashScript",
        "title": "CMake Embedded: Generate OpenOCD Flash Script"
      },
      {
        "command": "cmakeEmbedded.generateDebugConfiguration",
        "title": "CMake Embedded: Generate Cortex-Debug Configuration"
      },
      {
        "command": "cmakeEmbedded.importPack",
        "title": "CMake Embedded: Import CMSIS Pack"
      },
      {
        "command": "cmakeEmbedded.installPackOnline",
        "title": "CMake Embedded: Install Pack Online"
      },
      {
        "command": "cmakeEmbedded.removePack",
        "title": "CMake Embedded: Remove Imported CMSIS Pack"
      },
      {
        "command": "cmakeEmbedded.installCorePack",
        "title": "CMake Embedded: Install ARM CMSIS Core Pack"
      }
    ],
    "configuration": {
      "title": "CMake Embedded",
      "properties": {
        "cmakeEmbedded.openocdPath": {
          "type": "string",
          "default": "openocd",
          "description": "Path to the OpenOCD executable. Use openocd when it is available in PATH."
        },
        "cmakeEmbedded.jlinkPath": {
          "type": "string",
          "default": "JLink",
          "description": "J-Link Commander executable (JLink / JLink.exe / JLinkExe). Absolute path or a name found on PATH."
        },
        "cmakeEmbedded.pyocdPath": {
          "type": "string",
          "default": "pyocd",
          "description": "pyOCD executable used to flash CMSIS-Pack devices with ST-Link or DAPLink probes."
        },
        "cmakeEmbedded.packMirror": {
          "type": "string",
          "default": "",
          "description": "Pack 下载镜像根地址（可选）。形如 https://mirror.example.com/cmsis 的扁平目录，按 <vendor>.<name>.<version>.pack 提供文件。留空时直连官方 CDN。"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p ./ && node scripts/copy-sidebar-assets.js",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test out/test/*.test.js",
    "vsix": "npx --yes @vscode/vsce@4.1.0 package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}
